# Local development — see db/README.md for setup
DATABASE_URL=postgres://macbook_app:devpassword@localhost:5432/macbook_intake_dev

# Signs the session cookie. At least 32 chars: openssl rand -base64 32
# Rotating it signs everyone out, which is the intended panic button.
AUTH_SECRET=dev-only-secret-change-me-at-least-32-chars

# Shared across the bench. Gates /intake and /records; the docs stay public.
# There's no rate limiting in front of this — make it long and random in prod.
APP_PASSWORD=devpassword

# Production (Neon, via Vercel Marketplace): use the POOLED connection string and
# a role created by db/002_app_role.sql — never neondb_owner or neon_superuser.
# DATABASE_URL=postgres://macbook_app:...@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
